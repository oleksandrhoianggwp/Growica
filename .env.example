# Copy to .env and fill in. Never commit .env.

# ---- CAPTCHA -------------------------------------------------------------
# 2captcha  = solve the reCAPTCHA automatically through the 2captcha API (needs an API key with balance)
# manual    = an operator ticks the reCAPTCHA in a visible browser window (local run only, HEADLESS=false)
CAPTCHA_PROVIDER=2captcha
TWOCAPTCHA_API_KEY=
# CAPTCHA_SOLVE_TIMEOUT=180
# CAPTCHA_POLL_INTERVAL=5

# ---- Target form ---------------------------------------------------------
FORM_URL=https://linkreclamatiogrwc.uk/

# ---- Safety / rate limits ------------------------------------------------
# DRY_RUN=true fills the form but never solves the CAPTCHA or clicks Submit.
DRY_RUN=false
# Minimum seconds between two form submissions.
MIN_SUBMIT_INTERVAL=10
# Automatic attempts per target for transient errors (CAPTCHA unsolved, page load timeout).
MAX_AUTO_ATTEMPTS=2
# Hard cap on attempts per target, including manual retries.
MAX_TOTAL_ATTEMPTS=6
# Seconds an operator must wait before manually retrying the same target.
RETRY_COOLDOWN=30
MAX_TARGETS_PER_BATCH=100

# ---- Browser timeouts (seconds) -----------------------------------------
HEADLESS=true
NAVIGATION_TIMEOUT=45
ACTION_TIMEOUT=15
SUBMIT_RESULT_TIMEOUT=60
SUBMISSION_TIMEOUT=420

# ---- Server --------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
# json or text
LOG_FORMAT=json
